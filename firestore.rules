rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function userDocExists() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserRole() {
      return userDocExists()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'customer';
    }

    function isCustomer() {
      return isAuthenticated() && getUserRole() == 'customer';
    }

    function isSeller() {
      return isAuthenticated() && getUserRole() == 'seller';
    }

    function isFinance() {
      return isAuthenticated() && getUserRole() == 'finance';
    }

    function isBusinessHead() {
      return isAuthenticated() && getUserRole() == 'business_head';
    }

    function isValidCurrency(curr) {
      return curr in ['INR', 'USD'];
    }

    function isValidRole(r) {
      return r in ['customer', 'seller', 'finance', 'business_head'];
    }

    function isBusinessOwner(bizId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/businesses/$(bizId)) &&
        get(/databases/$(database)/documents/businesses/$(bizId)).data.ownerUid == request.auth.uid;
    }

    function getUserBizId() {
      return userDocExists()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.bizId
        : null;
    }

    function getUserActiveBizId() {
      return userDocExists()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.activeBizId
        : null;
    }

    function isBusinessMember(bizId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/businesses/$(bizId)) &&
        (
          isBusinessOwner(bizId) ||
          (
            (isSeller() || isFinance() || isBusinessHead()) &&
            (getUserBizId() == bizId || getUserActiveBizId() == bizId)
          )
        );
    }

    function isResourceTenantStaff() {
      return (isFinance() || isBusinessHead()) &&
        resource.data.get('bizId', null) != null &&
        (
          resource.data.get('bizId', null) == getUserBizId() ||
          resource.data.get('bizId', null) == getUserActiveBizId()
        );
    }

    function canManageBusiness(bizId) {
      return isBusinessMember(bizId) &&
        (isBusinessOwner(bizId) || isSeller() || isBusinessHead());
    }

    // ===============================================================
    // Multi-Tenant: Businesses, Storefront, Sub-collections & Domains
    // ===============================================================
    match /businesses/{bizId} {
      // Tenant profile contains ownerUid, paypalEmail, roleMembers & tax IDs; restrict reads to members.
      // Public storefronts load sanitized metadata via /api/storefront/:slug.
      allow read: if isBusinessMember(bizId);
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isBusinessOwner(bizId) &&
        request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isBusinessOwner(bizId);

      match /storefrontConfig/{configId} {
        allow read: if true; // Public for customer storefront rendering
        allow create, update, delete: if canManageBusiness(bizId);
      }

      match /products/{productId} {
        allow read: if true; // Public for customer catalog browsing
        allow create, update, delete: if canManageBusiness(bizId);
      }

      match /orders/{orderId} {
        // Single-document reads may be performed by tenant staff members or the owning customer.
        allow get: if isAuthenticated() && (
          isBusinessMember(bizId) ||
          resource.data.customerId == request.auth.uid ||
          (
            request.auth.token.email_verified == true &&
            resource.data.get('customerEmail', null) != null &&
            resource.data.customerEmail == request.auth.token.email
          )
        );
        // Collection listing is restricted to tenant staff members; customers use the authenticated server API.
        allow list: if isBusinessMember(bizId);
        // Payment/escrow orders are created and mutated only by the trusted server Admin SDK.
        allow create, update, delete: if false;
      }

      match /payments/{paymentId} {
        // Tenant staff members read payments; writes are server Admin SDK only.
        allow read: if isBusinessMember(bizId);
        allow write: if false;
      }

      match /escrowEvents/{eventId} {
        // Tenant staff members read the audit trail; writes are server Admin SDK only.
        allow read: if isBusinessMember(bizId);
        allow write: if false;
      }
    }

    match /_health/{docId} {
      // Ephemeral health checks run exclusively via server Admin SDK (SEC-009).
      allow read, write: if false;
    }

    match /domains/{domain} {
      allow read: if true; // Public for subdomain & custom domain routing
      allow create: if isAuthenticated() &&
        request.resource.data.bizId is string &&
        isBusinessMember(request.resource.data.bizId);
      allow update, delete: if isAuthenticated() &&
        resource.data.bizId is string &&
        isBusinessMember(resource.data.bizId);
    }

    // ===============================================================
    // 1. users (role & tenant identity immutable to clients)
    // ===============================================================
    match /users/{userId} {
      allow read: if isOwner(userId) || (
        (isFinance() || isBusinessHead()) &&
        getUserBizId() != null &&
        resource.data.get('bizId', null) == getUserBizId()
      );
      allow create: if isOwner(userId) &&
        request.resource.data.uid == userId &&
        request.resource.data.email is string &&
        request.resource.data.displayName is string &&
        request.resource.data.role == 'customer' &&
        !('activeBizId' in request.resource.data) &&
        !('isVerified' in request.resource.data) &&
        (!('bizId' in request.resource.data) || request.resource.data.bizId == 'biz-aerocool' || request.resource.data.bizId == null); // Privilege Escalation Prevention: self-signup is always lowest-privilege customer
      allow update: if isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'role', 'bizId', 'activeBizId', 'isVerified']) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.role == resource.data.role; // Role/tenant identity are admin-only mutations
      allow delete: if false;
    }

    // ===============================================================
    // 2. products (sellers edit only their own products; tenant members read only their business catalog)
    // ===============================================================
    match /products/{productId} {
      allow read: if isAuthenticated() &&
        ((resource.data.sellerId == request.auth.uid) ||
         ('bizId' in resource.data && isBusinessMember(resource.data.bizId)));
      allow create: if isSeller() &&
        request.resource.data.sellerId == request.auth.uid &&
        request.resource.data.priceMinor is int &&
        request.resource.data.priceMinor >= 0 &&
        isValidCurrency(request.resource.data.currency);
      allow update: if isSeller() &&
        resource.data.sellerId == request.auth.uid &&
        request.resource.data.sellerId == resource.data.sellerId &&
        request.resource.data.priceMinor is int &&
        request.resource.data.priceMinor >= 0;
      allow delete: if isSeller() && resource.data.sellerId == request.auth.uid;
    }

    // ===============================================================
    // 3. productAssets (sellers edit only their own product assets; tenant-scoped reads)
    // ===============================================================
    match /productAssets/{assetId} {
      allow read: if isAuthenticated() &&
        ((resource.data.sellerId == request.auth.uid) ||
         ('bizId' in resource.data && isBusinessMember(resource.data.bizId)));
      allow create: if isSeller() &&
        request.resource.data.sellerId == request.auth.uid &&
        request.resource.data.productId is string;
      allow update: if isSeller() &&
        resource.data.sellerId == request.auth.uid &&
        request.resource.data.sellerId == resource.data.sellerId;
      allow delete: if isSeller() && resource.data.sellerId == request.auth.uid;
    }

    // ===============================================================
    // 4. inventory (sellers edit only their own inventory; tenant-scoped reads)
    // ===============================================================
    match /inventory/{inventoryId} {
      allow read: if isAuthenticated() &&
        ((resource.data.sellerId == request.auth.uid) ||
         ('bizId' in resource.data && isBusinessMember(resource.data.bizId)));
      allow create: if isSeller() &&
        request.resource.data.sellerId == request.auth.uid &&
        request.resource.data.availableQty is int &&
        request.resource.data.availableQty >= 0;
      allow update: if isSeller() &&
        resource.data.sellerId == request.auth.uid &&
        request.resource.data.sellerId == resource.data.sellerId &&
        request.resource.data.availableQty is int &&
        request.resource.data.availableQty >= 0;
      allow delete: if isSeller() && resource.data.sellerId == request.auth.uid;
    }

    // ===============================================================
    // 5. carts (customers read/write only their own carts; business_head reads)
    // ===============================================================
    match /carts/{cartId} {
      allow read: if (isCustomer() && resource.data.customerId == request.auth.uid) || isResourceTenantStaff();
      allow create: if isCustomer() &&
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.budgetMinor is int &&
        isValidCurrency(request.resource.data.currency);
      allow update: if isCustomer() &&
        resource.data.customerId == request.auth.uid &&
        request.resource.data.customerId == resource.data.customerId &&
        request.resource.data.budgetMinor is int;
      allow delete: if isCustomer() && resource.data.customerId == request.auth.uid;
    }

    // ===============================================================
    // 6. orders (customers read only their own orders; sellers see only their own orders; tenant finance & business_head read; writes are server Admin SDK only)
    // ===============================================================
    match /orders/{orderId} {
      allow read: if (isCustomer() && resource.data.customerId == request.auth.uid) ||
        (isSeller() && resource.data.sellerId == request.auth.uid) ||
        isResourceTenantStaff();
      allow create, update, delete: if false;
    }

    // ===============================================================
    // 7. orderItems (same access boundaries as parent order; server Admin SDK only)
    // ===============================================================
    match /orderItems/{itemId} {
      allow read: if (isCustomer() && resource.data.customerId == request.auth.uid) ||
        (isSeller() && resource.data.sellerId == request.auth.uid) ||
        isResourceTenantStaff();
      allow create, update, delete: if false;
    }

    // ===============================================================
    // 8. payments (tenant finance/business_head & owner read; server Admin SDK writes only)
    // ===============================================================
    match /payments/{paymentId} {
      allow read: if isResourceTenantStaff() ||
        (isCustomer() && resource.data.customerId == request.auth.uid) ||
        (isSeller() && resource.data.sellerId == request.auth.uid);
      allow create, update, delete: if false;
    }

    // ===============================================================
    // 9. invoices (tenant finance/business_head read; seller reads/writes own; customer reads own)
    // ===============================================================
    match /invoices/{invoiceId} {
      allow read: if isResourceTenantStaff() ||
        (isSeller() && resource.data.sellerId == request.auth.uid) ||
        (isCustomer() && resource.data.customerId == request.auth.uid);
      allow create: if (
          (isFinance() && request.resource.data.get('bizId', null) != null &&
            (request.resource.data.bizId == getUserBizId() || request.resource.data.bizId == getUserActiveBizId())) ||
          (isSeller() && request.resource.data.sellerId == request.auth.uid &&
            (!('bizId' in request.resource.data) || request.resource.data.bizId == getUserBizId() || request.resource.data.bizId == getUserActiveBizId()))
        ) &&
        request.resource.data.totalMinor is int &&
        isValidCurrency(request.resource.data.currency);
      allow update: if (
          isResourceTenantStaff() ||
          (isSeller() && resource.data.sellerId == request.auth.uid)
        ) &&
        request.resource.data.sellerId == resource.data.sellerId &&
        request.resource.data.totalMinor is int;
      allow delete: if false;
    }

    // ===============================================================
    // 10. invoiceItems (tenant finance reads/writes; seller reads/writes own; tenant business_head reads)
    // ===============================================================
    match /invoiceItems/{itemId} {
      allow read: if isResourceTenantStaff() ||
        (isSeller() && resource.data.sellerId == request.auth.uid);
      allow create: if (
          (isFinance() && request.resource.data.get('bizId', null) != null &&
            (request.resource.data.bizId == getUserBizId() || request.resource.data.bizId == getUserActiveBizId())) ||
          (isSeller() && request.resource.data.sellerId == request.auth.uid &&
            (!('bizId' in request.resource.data) || request.resource.data.bizId == getUserBizId() || request.resource.data.bizId == getUserActiveBizId()))
        ) &&
        request.resource.data.totalMinor is int;
      allow update: if (isResourceTenantStaff() || (isSeller() && resource.data.sellerId == request.auth.uid)) &&
        request.resource.data.sellerId == resource.data.sellerId;
      allow delete: if false;
    }

    // ===============================================================
    // 11. refunds (tenant finance/business_head & owner read; server Admin SDK writes only)
    // ===============================================================
    match /refunds/{refundId} {
      allow read: if isResourceTenantStaff() ||
        (isCustomer() && resource.data.customerId == request.auth.uid) ||
        (isSeller() && resource.data.sellerId == request.auth.uid);
      allow create, update, delete: if false;
    }

    // ===============================================================
    // 12. escrowEvents (append-only audit trail; never updated or deleted by clients)
    // ===============================================================
    match /escrowEvents/{eventId} {
      allow read: if isResourceTenantStaff() ||
        (isCustomer() && resource.data.customerId == request.auth.uid) ||
        (isSeller() && resource.data.sellerId == request.auth.uid);
      allow create, update, delete: if false; // Append-only audit events are written by the trusted server Admin SDK
    }
  }
}
