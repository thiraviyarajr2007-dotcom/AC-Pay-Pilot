# ==============================================================================
# AC PayPilot — Environment Variables Example
# Copy this file to .env and fill in required values for local development.
# In production, inject these secrets via Cloud Secret Manager or container env.
# NEVER commit real secret values to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Environment Mode
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
# DEMO_MODE: Explicit flag required to enable mock users or simulated fallback endpoints.
# Defaults to false (FAIL CLOSED in production).
DEMO_MODE=false
VITE_DEMO_MODE=false

# ------------------------------------------------------------------------------
# 2. PayPal Sandbox Integration (Orders v2 API)
# ------------------------------------------------------------------------------
# PayPal Developer Sandbox Client ID (also exposed to browser for SDK Buttons)
PAYPAL_CLIENT_ID=""
# PayPal Developer Sandbox Client Secret (server-side ONLY, never sent to browser)
PAYPAL_CLIENT_SECRET=""
# Webhook ID configured in PayPal Developer Dashboard for Sandbox webhook verification
PAYPAL_WEBHOOK_ID=""
# Must remain "sandbox" (live real-money financial transactions are prohibited)
PAYPAL_ENV=sandbox

# ------------------------------------------------------------------------------
# 3. Currency Conversion Rate
# ------------------------------------------------------------------------------
# PayPal Orders v2 rejects direct INR checkout. Product catalog in INR is converted
# to USD for checkout using this fixed, configurable exchange rate.
INR_TO_USD_EXCHANGE_RATE=0.012

# ------------------------------------------------------------------------------
# 4. Google Firebase Admin SDK (Server-Side Persistence)
# ------------------------------------------------------------------------------
# Path to GCP Service Account JSON key file for Cloud Firestore database access.
# Required in production; absent credentials in production fail fast at startup.
GOOGLE_APPLICATION_CREDENTIALS=""

# ------------------------------------------------------------------------------
# 5. Google Gemini AI Engine
# ------------------------------------------------------------------------------
# Google AI Studio Gemini API Key for server-side agentic workflows (/api/copilot/tools)
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 6. Public Client Firebase SDK (Vite-Exposed)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID="ai-studio-applet-webapp-4bdcd"
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# ------------------------------------------------------------------------------
# 7. Application URL
# ------------------------------------------------------------------------------
APP_URL="http://localhost:3000"
