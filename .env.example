# GEMINI_API_KEY: Server-side secret required for Gemini AI API calls (/api/ai/suggest).
# AI Studio automatically injects this at runtime from user secrets. Never expose to client.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PAYPAL_CLIENT_ID: PayPal Sandbox REST API Client ID (Orders v2).
# Used by /api/config (for PayPal JS SDK Buttons) and server-side OAuth2 token exchange.
PAYPAL_CLIENT_ID="MY_PAYPAL_CLIENT_ID"

# PAYPAL_CLIENT_SECRET: Server-side secret for PayPal Sandbox REST API (Orders v2).
# Strictly kept on the server (server.ts); never exposed to the browser or logged.
PAYPAL_CLIENT_SECRET="MY_PAYPAL_CLIENT_SECRET"

# PAYPAL_ENV: Must remain "sandbox" (live payments are disabled).
PAYPAL_ENV="sandbox"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_AG_STUDIO_LICENSE: AG Studio Enterprise License Key (optional in trial/hackathon evaluation mode).
# Never hardcode in source files; read via import.meta.env.VITE_AG_STUDIO_LICENSE.
VITE_AG_STUDIO_LICENSE="MY_AG_STUDIO_LICENSE_KEY"

