{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/index" },
    { "source": "/health/live", "destination": "/api/index" },
    { "source": "/health/ready", "destination": "/api/index" },
    { "source": "/((?!api/|health$|health/).*)", "destination": "/index.html" }
  ]
}
